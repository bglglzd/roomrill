include LICENSE README.md pyproject.toml requirements-dev.txt
include CHANGELOG.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md .gitattributes .gitignore
recursive-include roomrill *.py
recursive-include roomrill/assets *.html *.css *.js *.svg
recursive-include docs *.md *.png *.svg *.json
recursive-include examples *.json
recursive-include tests *.py
recursive-include scripts *.py
recursive-include .github *.yml
global-exclude *.py[cod] *.sqlite *.sqlite-* *.db .DS_Store
prune .git
prune .venv
prune evidence
prune reports
prune build
prune dist
